{
  "name": "ste-strapi",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "strapi build",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "seed:example": "node ./scripts/seed.js",
    "s3:orphan:audit": "node ./scripts/s3-orphan-audit.js",
    "s3:orphan:delete": "node ./scripts/s3-orphan-delete.js",
    "openapi:gen": "strapi openapi generate --output ./docs/openapi.generated.json",
    "openapi:overrides": "node ./scripts/openapi/index.mjs",
    "openapi:merge": "node ./scripts/merge-openapi.mjs",
    "openapi": "yarn openapi:gen && yarn openapi:overrides && yarn openapi:merge",
    "permissions:export": "node ./scripts/users-permissions/export.js",
    "permissions:sync": "node ./scripts/users-permissions/sync.js",
    "start": "strapi start",
    "strapi": "strapi",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry",
    "lint": "eslint . --ext .ts,.js --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@strapi/plugin-cloud": "5.32.0",
    "@strapi/plugin-users-permissions": "5.32.0",
    "@strapi/provider-upload-aws-s3": "^5.33.2",
    "@strapi/strapi": "5.32.0",
    "csv-parse": "^6.1.0",
    "fs-extra": "^10.0.0",
    "mime-types": "^2.1.27",
    "pdfkit": "^0.17.2",
    "pg": "8.8.0",
    "qrcode": "^1.5.4",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5",
    "zod": "^4.3.5"
  },
  "engines": {
    "node": ">=20.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": "40554efc-9eae-4eb1-9be2-8e8c5e696e60",
    "installId": "ee12c8f8c0571c856a2943eab1c1085bcac8e7df011c767abf3533c5db8734eb"
  }
}
